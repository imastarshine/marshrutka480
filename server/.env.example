# Copy to .env. run.py and Docker Compose read this file.
# Development: open http://localhost:8000 or http://127.0.0.1:8000.
M480_ENV=development
M480_DATABASE=data/marshrutka.sqlite3
M480_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
M480_HOSTS=localhost,127.0.0.1

# 0 = no fixed application connection cap for the public city.
# Set positive values only if an operational ceiling is needed on your host.
M480_MAX_CONNECTIONS=0
M480_HTTP_CONCURRENCY=0

# Production example (replace game.example.com with your real domain):
# M480_ENV=production
# M480_ORIGINS=https://game.example.com,https://imastarshine.github.io
# M480_HOSTS=game.example.com,localhost,127.0.0.1
# Origins contain scheme + host (+port), NEVER a path or a trailing slash.

# Docker binds only localhost by default. Use a local HTTPS reverse proxy.
M480_BIND=127.0.0.1
M480_PORT=8000
# If Caddy/nginx and Python both run directly on this same host:
# M480_PROXY_IPS=127.0.0.1
# Docker Compose separately trusts its explicit bridge gateway.
